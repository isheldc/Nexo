@import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap');

/* ==========================================================================
   VARIABLES Y TEMAS (DARK / LIGHT)
   ========================================================================== */
:root {
    --bg-dark: #0a0e14;
    --card-bg: #111822;
    --card-border: #1e293b;
    --level-card-bg: #131c28;
    --level-card-border: #233246;
    --box-inner-bg: #0d1520;
    --input-bg: #0a0f16;
    --neon-blue: #00e5ff;
    --neon-purple: #a855f7;
    --neon-green: #10b981;
    --neon-amber: #f59e0b;
    --text-main: #f8fafc;
    --text-muted: #94a3b8;
    --font: 'Nunito', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    
    /* Alias de compatibilidad */
    --background: var(--bg-dark);
    --panel: var(--card-bg);
    --panel-light: var(--level-card-bg);
    --cyan: var(--neon-blue);
    --purple: var(--neon-purple);
    --green: var(--neon-green);
    --border: var(--card-border);
}

/* PALETA PARA MODO CLARO */
[data-theme="light"] {
    --bg-dark: #f1f5f9;
    --card-bg: #ffffff;
    --card-border: #cbd5e1;
    --level-card-bg: #f8fafc;
    --level-card-border: #e2e8f0;
    --box-inner-bg: #f1f5f9;
    --input-bg: #ffffff;
    --neon-blue: #0284c7;
    --neon-purple: #7e22ce;
    --neon-green: #059669;
    --neon-amber: #d97706;
    --text-main: #0f172a;
    --text-muted: #64748b;

    --background: var(--bg-dark);
    --panel: var(--card-bg);
    --panel-light: var(--level-card-bg);
    --cyan: var(--neon-blue);
    --purple: var(--neon-purple);
    --green: var(--neon-green);
    --border: var(--card-border);
}

/* ==========================================================================
   RESET Y REGLAS GENERALES
   ========================================================================== */
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: var(--font);
    min-height: 100vh;
    transition: background-color 0.3s ease, color 0.3s ease;
}

button, input, select, textarea {
    font: inherit;
}

button {
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
}

button:hover {
    transform: translateY(-1px);
    filter: brightness(1.1);
}

.hidden { 
    display: none !important; 
}

/* ==========================================================================
   PANTALLA DE ACCESO (LOGIN)
   ========================================================================== */
.login-screen {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background:
        radial-gradient(circle at 15% 20%, rgba(0, 229, 255, 0.15) 0, transparent 35%),
        radial-gradient(circle at 85% 80%, rgba(168, 85, 247, 0.15) 0, transparent 35%),
        var(--bg-dark);
}

.login-card {
    width: 100%;
    max-width: 420px;
    background: var(--card-bg);
    padding: 40px;
    border: 1px solid var(--card-border);
    border-radius: 24px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4);
    text-align: center;
}

.logo {
    font-size: 50px;
    margin-bottom: 10px;
    filter: drop-shadow(0 0 12px var(--neon-blue));
}

.login-card h1 {
    font-size: 1.8rem;
    font-weight: 900;
}

.login-card h1 span {
    color: var(--neon-blue);
}

.login-card > p {
    color: var(--text-muted);
    margin: 8px 0 25px;
    font-size: 0.9rem;
    line-height: 1.4;
}

.login-card form {
    text-align: left;
}

label {
    display: block;
    color: var(--text-muted);
    font-weight: 700;
    margin: 12px 0 6px;
    font-size: 0.85rem;
}

/* ==========================================================================
   ESTRUCTURA APP CON SIDEBAR Y CONTENIDO PRINCIPAL
   ========================================================================== */
.app {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 250px;
    flex-shrink: 0;
    background: var(--card-bg);
    border-right: 1px solid var(--card-border);
    padding: